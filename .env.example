# Copy this file to .env.local for local development. Never commit real values,
# and never paste real values into chat, tickets, or attachments.

# ── Database (Supabase / Supavisor) ─────────────────────────────────────────
# Runtime connection used by the app on Vercel. Supavisor TRANSACTION mode,
# port 6543, with pgbouncer settings. Serverless functions must use this URL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Migration connection used only by Prisma CLI (migrate/seed/studio). Supavisor
# SESSION mode, port 5432 (or a direct connection). NOT needed by the Vercel runtime.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ── NextAuth ────────────────────────────────────────────────────────────────
# Generate a strong secret, e.g. `openssl rand -base64 32`. Use DIFFERENT
# secrets for local, Preview, and Production. Required in Production.
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Local: http://localhost:3000
# Vercel Production: set to the production URL (e.g. https://<project>.vercel.app)
# Vercel Preview: leave UNSET so NextAuth uses the per-deployment Vercel URL.
NEXTAUTH_URL="http://localhost:3000"

# ── Email (optional) ────────────────────────────────────────────────────────
# The contact form currently uses Ethereal test accounts (no real delivery),
# so no SMTP credentials are required yet. This only sets the From header.
# CONTACT_FROM_EMAIL="Alliances Platform <no-reply@alliances.local>"
